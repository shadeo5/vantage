# Copy to .env and fill from Supabase dashboard → Project Settings → API.
# These are the PUBLIC anon values (safe to ship; data is protected by RLS).
# The service_role secret is NOT here — it lives only in Supabase's own settings.
EXPO_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<your-anon-public-key>
