{
  "name": "vantage-content-pipeline",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Per-city content pipeline: real places -> Claude drafts spot content -> JSON the app can use.",
  "scripts": {
    "curate": "node --env-file-if-exists=.env curate.mjs",
    "generate": "node --env-file-if-exists=.env generate.mjs",
    "images": "node --env-file-if-exists=.env build-images.mjs",
    "seed": "node build-seed.mjs",
    "seed:events": "node build-events-seed.mjs",
    "image-urls": "node build-image-urls.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "openai": "^6.47.0",
    "sharp": "^0.35.3"
  }
}
