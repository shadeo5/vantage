{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/precommit-check.sh\"",
            "timeout": 120,
            "statusMessage": "Pre-commit gate: npm run check + docs"
          }
        ]
      }
    ]
  }
}
