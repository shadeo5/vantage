# Copy this file to ".env" and paste your ONE free API key.
#   cp .env.example .env
# Then edit .env and fill this in.

# Ticketmaster Discovery: get a free key at https://developer.ticketmaster.com/
# After signing up, use your app's "Consumer Key".
TICKETMASTER_API_KEY=your_ticketmaster_key_here

# (OpenStreetMap / Overpass needs no key — the script uses it automatically.)
